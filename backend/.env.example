# Database Connection Configuration
# For MySQL:
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=construction_db

# Fallback behavior: If DB_DIALECT=sqlite or if MySQL connection fails,
# the app seamlessly uses local SQLite (database.sqlite) with identical schema & seed.
# To force SQLite directly, set: DB_DIALECT=sqlite

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret & Token Lifespan
JWT_SECRET=construction_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Domain Rules
LOW_STOCK_THRESHOLD=10
